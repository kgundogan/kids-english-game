{
  "expo": {
    "name": "Pofi Adası",
    "slug": "kids-english-game",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Pofi seni duyabilmek için mikrofona ihtiyaç duyar.",
          "speechRecognitionPermission": "Pofi söylediğin kelimeyi anlamak için konuşma tanıma kullanır."
        }
      ],
      "expo-splash-screen",
      "expo-audio"
    ],
    "scheme": "pofi",
    "experiments": {
      "typedRoutes": true
    }
  }
}
